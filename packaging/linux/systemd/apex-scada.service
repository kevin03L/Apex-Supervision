# Unité systemd du moteur Apex Supervision (installée par le paquet apex-supervision).
# Personnalisation : systemctl edit apex-scada (fichier de surcharge, conservé aux mises à jour).

[Unit]
Description=Apex Supervision — moteur GTC/SCADA et serveur web
Documentation=file:///usr/share/doc/apex-supervision/INSTALLATION.md
After=network-online.target
Wants=network-online.target

[Service]
# Le moteur signale « prêt » (sd_notify) une fois le serveur web ouvert
Type=notify
NotifyAccess=main
User=apex-scada
Group=apex-scada
ExecStart=/usr/bin/apex-scada run --config /etc/apex-supervision/apex-scada.toml

# Redémarrage après un crash, mais pas en boucle sur une erreur de démarrage
# (2 usage, 3 configuration invalide, 4 instance déjà active, 5 port indisponible, 6 base inaccessible)
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=2 3 4 5 6
# Arrêt propre : drivers, dernier lot d'historique, jeton local
KillSignal=SIGTERM
TimeoutStopSec=30

# Répertoires créés par systemd avec le bon propriétaire
StateDirectory=apex-supervision
StateDirectoryMode=0750
LogsDirectory=apex-supervision
LogsDirectoryMode=0750
RuntimeDirectory=apex-supervision
RuntimeDirectoryMode=0750
UMask=0027

# Durcissement : le moteur ne lit que sa configuration et n'écrit que dans ses répertoires
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Aucune capacité : un port web inférieur à 1024 exige une surcharge
# (systemctl edit apex-scada → AmbientCapabilities=CAP_NET_BIND_SERVICE et
#  CapabilityBoundingSet=CAP_NET_BIND_SERVICE)
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
